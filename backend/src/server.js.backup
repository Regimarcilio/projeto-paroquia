const express = require('express');
const cors = require('cors');
const bcrypt = require('bcryptjs');
const path = require('path');
const sqlite3 = require('sqlite3').verbose();
const { open } = require('sqlite');

const app = express();
const PORT = 8000;

app.use(cors());
app.use(express.json());

let db;

// Conectar ao banco
async function initDB() {
  db = await open({
    filename: './data/paroquia.db',
    driver: sqlite3.Database
  });
  console.log('✅ Conectado ao SQLite!');
  
  // ============= TABELAS =============
  
  // Usuários
  await db.exec(`
    CREATE TABLE IF NOT EXISTS usuarios (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      email TEXT UNIQUE NOT NULL,
      senha_hash TEXT NOT NULL,
      is_admin INTEGER DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
  
  // Notícias
  await db.exec(`
    CREATE TABLE IF NOT EXISTS noticias (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      titulo TEXT NOT NULL,
      conteudo TEXT NOT NULL,
      imagem TEXT,
      data_publicacao DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
  
  // Eventos
  await db.exec(`
    CREATE TABLE IF NOT EXISTS eventos (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      descricao TEXT,
      data DATETIME,
      horario TEXT,
      local TEXT,
      imagem TEXT,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
  
  // Horários
  await db.exec(`
    CREATE TABLE IF NOT EXISTS horarios (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      dia_semana TEXT NOT NULL,
      horario TEXT NOT NULL,
      tipo TEXT DEFAULT 'Missa',
      ativo INTEGER DEFAULT 1
    )
  `);
  
  // Pastorais
  await db.exec(`
    CREATE TABLE IF NOT EXISTS pastorais (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      descricao TEXT NOT NULL,
      responsavel TEXT,
      contato TEXT,
      imagem TEXT,
      ativo INTEGER DEFAULT 1
    )
  `);
  
  // Mensagens de Contato
  await db.exec(`
    CREATE TABLE IF NOT EXISTS contatos (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      nome TEXT NOT NULL,
      email TEXT NOT NULL,
      telefone TEXT,
      mensagem TEXT NOT NULL,
      respondido INTEGER DEFAULT 0,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);
  
  // Informações da Paróquia (Sobre)
  await db.exec(`
    CREATE TABLE IF NOT EXISTS sobre (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      historia TEXT,
      missao TEXT,
      visao TEXT,
      valores TEXT,
      padroeiro TEXT,
      endereco TEXT,
      telefone TEXT,
      email TEXT,
      whatsapp TEXT,
      mapa_embed TEXT
    )
  `);
  
  // Criar admin
  const admin = await db.get('SELECT * FROM usuarios WHERE email = ?', ['admin@paroquia.com']);
  if (!admin) {
    const hashedPassword = await bcrypt.hash('admin123', 10);
    await db.run(
      'INSERT INTO usuarios (nome, email, senha_hash, is_admin) VALUES (?, ?, ?, ?)',
      ['Administrador', 'admin@paroquia.com', hashedPassword, 1]
    );
    console.log('✅ Admin criado!');
  }
  
  // Criar horários padrão
  const horariosCount = await db.get('SELECT COUNT(*) as count FROM horarios');
  if (horariosCount.count === 0) {
    const horarios = [
      ['Domingo', '08:00', 'Missa', 1], ['Domingo', '10:00', 'Missa', 1], ['Domingo', '19:00', 'Missa', 1],
      ['Segunda', '19:00', 'Missa', 1], ['Terça', '19:00', 'Missa', 1], ['Quarta', '19:00', 'Missa', 1],
      ['Quinta', '19:00', 'Missa', 1], ['Quinta', '18:00', 'Adoração', 1],
      ['Sexta', '15:00', 'Missa', 1], ['Sexta', '19:00', 'Terço', 1],
      ['Sábado', '16:00', 'Confissões', 1], ['Sábado', '17:00', 'Missa', 1], ['Sábado', '19:00', 'Missa', 1]
    ];
    for (const h of horarios) {
      await db.run('INSERT INTO horarios (dia_semana, horario, tipo, ativo) VALUES (?, ?, ?, ?)', h);
    }
    console.log('✅ Horários padrão criados!');
  }
  
  // Criar pastorais padrão
  const pastoraisCount = await db.get('SELECT COUNT(*) as count FROM pastorais');
  if (pastoraisCount.count === 0) {
    const pastorais = [
      ['Catequese', 'Formação cristã para crianças, adolescentes e adultos.', 'Ir. Maria', '(11) 99999-1111', ''],
      ['Grupo de Jovens', 'Encontros semanais para jovens, formação e missão.', 'João Silva', '(11) 99999-2222', ''],
      ['Pastoral da Família', 'Apoio às famílias e preparação para o matrimônio.', 'Antônio e Maria', '(11) 99999-3333', ''],
      ['Pastoral Social', 'Ações de caridade e promoção humana.', 'Francisco Lima', '(11) 99999-4444', ''],
      ['Liturgia', 'Organização das celebrações litúrgicas.', 'Ana Paula', '(11) 99999-5555', ''],
      ['Ministros da Eucaristia', 'Ministros que auxiliam na distribuição da comunhão.', 'Carlos Alberto', '(11) 99999-6666', '']
    ];
    for (const p of pastorais) {
      await db.run('INSERT INTO pastorais (nome, descricao, responsavel, contato, imagem) VALUES (?, ?, ?, ?, ?)', p);
    }
    console.log('✅ Pastorais padrão criadas!');
  }
  
  // Criar informações padrão da paróquia
  const sobreCount = await db.get('SELECT COUNT(*) as count FROM sobre');
  if (sobreCount.count === 0) {
    await db.run(`
      INSERT INTO sobre (historia, missao, visao, valores, padroeiro, endereco, telefone, email, whatsapp) 
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      'Fundada em 1974, a Paróquia São Miguel Arcanjo nasceu do sonho de um grupo de fiéis...',
      'Evangelizar, celebrar a fé e promover a dignidade humana...',
      'Ser uma comunidade viva, acolhedora e missionária...',
      'Fé, Comunhão, Serviço, Alegria, Hospitalidade...',
      'São Miguel Arcanjo - Celebrado em 29 de setembro',
      'Rua da Igreja, 123 - Centro, Cidade - Estado',
      '(11) 1234-5678',
      'contato@paroquiasaomiguel.org',
      '(11) 98765-4321'
    ]);
    console.log('✅ Informações da paróquia criadas!');
  }
  
  console.log('✅ Banco inicializado!');
}

initDB();

// Middleware auth
const authMiddleware = (req, res, next) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (token === 'admin-token') {
    next();
  } else {
    res.status(401).json({ error: 'Não autorizado' });
  }
};

// ============= ROTAS PÚBLICAS =============

app.get('/api/health', (req, res) => {
  res.json({ status: 'healthy', timestamp: new Date() });
});

// Notícias
app.get('/api/noticias/', async (req, res) => {
  const noticias = await db.all('SELECT * FROM noticias ORDER BY data_publicacao DESC');
  res.json(noticias);
});

app.get('/api/noticias/:id', async (req, res) => {
  const noticia = await db.get('SELECT * FROM noticias WHERE id = ?', [req.params.id]);
  res.json(noticia || null);
});

// Eventos
app.get('/api/eventos/', async (req, res) => {
  const eventos = await db.all('SELECT * FROM eventos ORDER BY data DESC');
  res.json(eventos);
});

app.get('/api/eventos/proximos', async (req, res) => {
  const hoje = new Date().toISOString();
  const eventos = await db.all('SELECT * FROM eventos WHERE data >= ? ORDER BY data ASC LIMIT 5', [hoje]);
  res.json(eventos);
});

// Horários
app.get('/api/horarios/agrupados', async (req, res) => {
  const horarios = await db.all('SELECT * FROM horarios WHERE ativo = 1');
  const dias = ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'];
  const agrupados = {};
  dias.forEach(d => agrupados[d] = []);
  horarios.forEach(h => {
    if (agrupados[h.dia_semana]) {
      agrupados[h.dia_semana].push({ horario: h.horario, tipo: h.tipo });
    }
  });
  res.json(agrupados);
});

// Pastorais
app.get('/api/pastorais/', async (req, res) => {
  const pastorais = await db.all('SELECT * FROM pastorais WHERE ativo = 1');
  res.json(pastorais);
});

// Sobre (informações da paróquia)
app.get('/api/sobre/', async (req, res) => {
  const sobre = await db.get('SELECT * FROM sobre WHERE id = 1');
  res.json(sobre || {});
});

// Contato (receber mensagens)
app.post('/api/contato/', async (req, res) => {
  const { nome, email, telefone, mensagem } = req.body;
  const result = await db.run(
    'INSERT INTO contatos (nome, email, telefone, mensagem) VALUES (?, ?, ?, ?)',
    [nome, email, telefone, mensagem]
  );
  res.status(201).json({ message: 'Mensagem enviada!', id: result.lastID });
});

// Login
app.post('/api/auth/login', async (req, res) => {
  const { email, senha } = req.body;
  const user = await db.get('SELECT * FROM usuarios WHERE email = ?', [email]);
  if (!user) return res.status(401).json({ error: 'Credenciais inválidas' });
  
  const valid = await bcrypt.compare(senha, user.senha_hash);
  if (!valid) return res.status(401).json({ error: 'Credenciais inválidas' });
  
  res.json({ token: 'admin-token', user: { id: user.id, nome: user.nome, email: user.email, isAdmin: user.is_admin } });
});

// ============= ROTAS ADMIN (CRUD COMPLETO) =============

// Notícias
app.get('/api/admin/noticias', authMiddleware, async (req, res) => {
  const noticias = await db.all('SELECT * FROM noticias ORDER BY data_publicacao DESC');
  res.json(noticias);
});
app.post('/api/admin/noticias', authMiddleware, async (req, res) => {
  const { titulo, conteudo, imagem } = req.body;
  const result = await db.run('INSERT INTO noticias (titulo, conteudo, imagem) VALUES (?, ?, ?)', [titulo, conteudo, imagem || '']);
  const noticia = await db.get('SELECT * FROM noticias WHERE id = ?', [result.lastID]);
  res.status(201).json(noticia);
});
app.put('/api/admin/noticias/:id', authMiddleware, async (req, res) => {
  const { id } = req.params;
  const { titulo, conteudo, imagem } = req.body;
  await db.run('UPDATE noticias SET titulo = ?, conteudo = ?, imagem = ? WHERE id = ?', [titulo, conteudo, imagem || '', id]);
  const noticia = await db.get('SELECT * FROM noticias WHERE id = ?', [id]);
  res.json(noticia);
});
app.delete('/api/admin/noticias/:id', authMiddleware, async (req, res) => {
  await db.run('DELETE FROM noticias WHERE id = ?', [req.params.id]);
  res.status(204).send();
});

// Eventos
app.get('/api/admin/eventos', authMiddleware, async (req, res) => {
  const eventos = await db.all('SELECT * FROM eventos ORDER BY data DESC');
  res.json(eventos);
});
app.post('/api/admin/eventos', authMiddleware, async (req, res) => {
  const { nome, descricao, data, horario, local, imagem } = req.body;
  const result = await db.run(
    'INSERT INTO eventos (nome, descricao, data, horario, local, imagem) VALUES (?, ?, ?, ?, ?, ?)',
    [nome, descricao, data, horario, local, imagem || '']
  );
  const evento = await db.get('SELECT * FROM eventos WHERE id = ?', [result.lastID]);
  res.status(201).json(evento);
});
app.put('/api/admin/eventos/:id', authMiddleware, async (req, res) => {
  const { id } = req.params;
  const { nome, descricao, data, horario, local, imagem } = req.body;
  await db.run(
    'UPDATE eventos SET nome = ?, descricao = ?, data = ?, horario = ?, local = ?, imagem = ? WHERE id = ?',
    [nome, descricao, data, horario, local, imagem || '', id]
  );
  const evento = await db.get('SELECT * FROM eventos WHERE id = ?', [id]);
  res.json(evento);
});
app.delete('/api/admin/eventos/:id', authMiddleware, async (req, res) => {
  await db.run('DELETE FROM eventos WHERE id = ?', [req.params.id]);
  res.status(204).send();
});

// Horários
app.get('/api/admin/horarios', authMiddleware, async (req, res) => {
  const horarios = await db.all('SELECT * FROM horarios');
  res.json(horarios);
});
app.post('/api/admin/horarios', authMiddleware, async (req, res) => {
  const { diaSemana, horario, tipo, ativo } = req.body;
  const result = await db.run(
    'INSERT INTO horarios (dia_semana, horario, tipo, ativo) VALUES (?, ?, ?, ?)',
    [diaSemana, horario, tipo, ativo ? 1 : 0]
  );
  const horarioNovo = await db.get('SELECT * FROM horarios WHERE id = ?', [result.lastID]);
  res.status(201).json(horarioNovo);
});
app.put('/api/admin/horarios/:id', authMiddleware, async (req, res) => {
  const { id } = req.params;
  const { diaSemana, horario, tipo, ativo } = req.body;
  await db.run(
    'UPDATE horarios SET dia_semana = ?, horario = ?, tipo = ?, ativo = ? WHERE id = ?',
    [diaSemana, horario, tipo, ativo ? 1 : 0, id]
  );
  const horarioAtualizado = await db.get('SELECT * FROM horarios WHERE id = ?', [id]);
  res.json(horarioAtualizado);
});
app.delete('/api/admin/horarios/:id', authMiddleware, async (req, res) => {
  await db.run('DELETE FROM horarios WHERE id = ?', [req.params.id]);
  res.status(204).send();
});

