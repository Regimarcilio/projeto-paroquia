version: '3.8'

services:
  db:
    image: postgres:13
    environment:
      POSTGRES_USER: paroquia
      POSTGRES_PASSWORD: paroquia123
      POSTGRES_DB: paroquia_db
    volumes:
      - postgres_data:/var/lib/postgresql/data

  backend:
    build: ./backend
    container_name: paroquia_backend_node
    environment:
      DATABASE_URL: "postgresql://paroquia:paroquia123@db:5432/paroquia_db"
    ports:
      - "8000:8000"
    depends_on:
      - db
    command: sh -c "npm install && npx prisma generate && npx prisma db push --accept-data-loss && npm start"
    volumes:
      - ./backend:/app
      - /app/node_modules
      - uploads_data:/app/uploads

  frontend:
    image: nginx:alpine
    container_name: paroquia_frontend
    ports:
      - "80:80"
    depends_on:
      - backend
    volumes:
      - ./frontend:/usr/share/nginx/html
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf

volumes:
  postgres_data:
  uploads_data:
