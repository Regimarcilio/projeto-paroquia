/* ==========================================
   DESIGN: PARÓQUIA SÃO MIGUEL ARCANJO
   ========================================== */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap');

:root {
  --primary-color: #0f2b3d;
  --secondary-color: #c9a227;
  --accent-color: #1a4070;
  --text-color: #333333;
  --text-light: #666666;
  --bg-light: #f8f9fa;
  --white: #ffffff;
  --gold: #d4af37;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Lato', sans-serif;
  background-color: var(--white);
  color: var(--text-color);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
  transition: 0.3s;
}

ul {
  list-style: none;
}

img {
  max-width: 100%;
  height: auto;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

/* ==================== HEADER ==================== */
.header {
  background: var(--white);
  width: 100%;
  top: 0;
  z-index: 999;
  box-shadow: 0 2px 15px rgba(0,0,0,0.08);
  position: fixed;
}

.top-bar {
  background: var(--primary-color);
  color: rgba(255,255,255,0.85);
  font-size: 0.8rem;
  padding: 8px 0;
  letter-spacing: 0.5px;
}

.top-bar .container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.top-bar i {
  color: var(--secondary-color);
  margin-right: 6px;
}

.nav-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 90px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-icon {
  width: 50px;
  height: 50px;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--secondary-color);
  font-size: 1.5rem;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.logo-text h1 {
  font-family: 'Cinzel', serif;
  font-size: 1.3rem;
  color: var(--primary-color);
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.logo-text span {
  display: block;
  font-size: 0.7rem;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-weight: 600;
  margin-top: 3px;
}

.nav-menu {
  display: flex;
  gap: 25px;
  align-items: center;
}

.nav-link {
  font-size: 0.85rem;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--text-color);
  letter-spacing: 0.5px;
  position: relative;
  padding: 5px 0;
}

.nav-link:hover {
  color: var(--primary-color);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--secondary-color);
  transition: 0.3s;
}

.nav-link:hover::after {
  width: 100%;
}

.btn-donate {
  background: var(--secondary-color);
  color: white;
  padding: 10px 28px;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-weight: 700;
  border-radius: 30px;
  box-shadow: 0 4px 12px rgba(201, 162, 39, 0.3);
  transition: all 0.3s;
}

.btn-donate:hover {
  background: #b38f1f;
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(201, 162, 39, 0.4);
}

/* ==================== HERO ==================== */
.hero {
  height: 85vh;
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  margin-top: 130px;
  background: linear-gradient(rgba(15, 43, 61, 0.75), rgba(15, 43, 61, 0.85)), url('https://images.unsplash.com/photo-1548625149-fc4a29cf7092?q=80&w=1920');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.hero-content {
  z-index: 2;
  max-width: 800px;
  padding: 0 20px;
}

.hero-subtitle {
  font-family: 'Cinzel', serif;
  color: var(--secondary-color);
  font-size: 1rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin-bottom: 15px;
  display: block;
}

.hero-title {
  font-family: 'Cinzel', serif;
  font-size: 3.5rem;
  color: white;
  margin-bottom: 20px;
  line-height: 1.2;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.hero-desc {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.9);
  margin-bottom: 35px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  font-weight: 300;
}

/* ==================== SCHEDULE BOX ==================== */
.schedule-box {
  background: white;
  margin: -70px auto 50px;
  position: relative;
  z-index: 10;
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  padding: 35px;
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  border-top: 4px solid var(--secondary-color);
  border-radius: 12px;
  max-width: 1000px;
}

.schedule-item {
  text-align: center;
  padding: 10px 25px;
  flex: 1;
}

.schedule-item h3 {
  font-family: 'Cinzel', serif;
  color: var(--primary-color);
  font-size: 1.1rem;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.schedule-item p {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 5px;
}

.schedule-item span {
  font-size: 0.8rem;
  color: #888;
  font-style: italic;
}

.schedule-icon {
  color: var(--secondary-color);
  margin-right: 8px;
}

/* ==================== SECTIONS ==================== */
.section {
  padding: 80px 0;
}

.bg-gray {
  background: var(--bg-light);
}

.section-title {
  text-align: center;
  margin-bottom: 55px;
}

.section-title h2 {
  font-family: 'Cinzel', serif;
  font-size: 2.2rem;
  color: var(--primary-color);
  text-transform: uppercase;
  position: relative;
  display: inline-block;
  padding-bottom: 15px;
}

.section-title h2::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 70px;
  height: 3px;
  background: var(--secondary-color);
}

/* Grid Cards */
.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.card-minimal {
  background: white;
  padding: 35px 25px;
  text-align: center;
  border: 1px solid #eee;
  border-radius: 12px;
  transition: all 0.3s ease;
  box-shadow: 0 5px 15px rgba(0,0,0,0.03);
}

.card-minimal:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.1);
  border-color: transparent;
}

.card-icon {
  font-size: 2.5rem;
  color: var(--secondary-color);
  margin-bottom: 18px;
}

.card-minimal h4 {
  font-family: 'Cinzel', serif;
  font-size: 1.1rem;
  margin-bottom: 12px;
  color: var(--primary-color);
}

.card-minimal p {
  font-size: 0.9rem;
  color: #666;
  line-height: 1.5;
}

/* ==================== PAGE HEADER ==================== */
.page-header {
  background: linear-gradient(135deg, var(--primary-color) 0%, #1a3a4f 100%);
  padding: 140px 0 70px;
  text-align: center;
  color: white;
}

.page-header h1 {
  font-family: 'Cinzel', serif;
  font-size: 2.5rem;
  margin-bottom: 15px;
}

.page-header p {
  font-size: 1rem;
  opacity: 0.9;
}

/* ==================== FOOTER ==================== */
.footer {
  background: var(--primary-color);
  color: rgba(255,255,255,0.75);
  padding: 60px 0 20px;
  margin-top: 60px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.footer-title {
  font-family: 'Cinzel', serif;
  color: white;
  font-size: 1.1rem;
  margin-bottom: 20px;
  text-transform: uppercase;
}

.footer-about p {
  line-height: 1.7;
  font-size: 0.85rem;
}

.footer-links ul li {
  margin-bottom: 10px;
}

.footer-links ul li a {
  color: rgba(255,255,255,0.7);
  font-size: 0.85rem;
  transition: 0.3s;
}

.footer-links ul li a:hover {
  color: var(--secondary-color);
  padding-left: 5px;
}

.footer-social {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.footer-social a {
  width: 35px;
  height: 35px;
  border: 1px solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: white;
  transition: 0.3s;
}

.footer-social a:hover {
  background: var(--secondary-color);
  border-color: var(--secondary-color);
  transform: translateY(-3px);
}

.copyright {
  text-align: center;
  padding: 20px 0;
  font-size: 0.75rem;
  margin-top: 20px;
  color: rgba(255,255,255,0.6);
}

/* ==================== RESPONSIVO ==================== */
@media (max-width: 992px) {
  .grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .nav-menu {
    display: none;
  }
  .hero-title {
    font-size: 2.5rem;
  }
}

@media (max-width: 768px) {
  .hero {
    margin-top: 110px;
    height: auto;
    padding: 80px 0;
  }
  .hero-title {
    font-size: 1.8rem;
  }
  .schedule-box {
    margin: -50px 20px 40px;
    padding: 25px;
    flex-direction: column;
    gap: 20px;
  }
  .schedule-item {
    width: 100%;
    border-bottom: 1px solid #eee;
    padding-bottom: 15px;
  }
  .schedule-item:last-child {
    border-bottom: none;
  }
  .grid-4 {
    grid-template-columns: 1fr;
  }
  .footer-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .footer-social {
    justify-content: center;
  }
  .section-title h2 {
    font-size: 1.6rem;
  }
  .page-header h1 {
    font-size: 1.8rem;
  }
}
